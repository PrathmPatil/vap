# Copy to .env.production on the server (runtime) AND pass the same values
# as docker compose build-args (see docker-compose.yml).
#
# Next.js embeds NEXT_PUBLIC_* at BUILD time. After changing these, you MUST:
#   docker compose build --no-cache frontend && docker compose up -d frontend

NEXT_PUBLIC_API_URL=https://trendtraders.in/vap
NEXT_PUBLIC_PYTHON_API_URL=https://trendtraders.in/ml
